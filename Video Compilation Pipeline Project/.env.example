# ============================================================
#  Web Data Driven Video Compilation Pipeline - Environment
# ============================================================

# ----------------------------------------------------------
# Google Gemini API
# Get your key at: https://aistudio.google.com/apikeys
# ----------------------------------------------------------
GOOGLE_GENAI_API_KEY=key_here

# Gemini model to use for script generation
GOOGLE_GENAI_MODEL=gemini-3.1-flash-lite

# ----------------------------------------------------------
# Pexels API (FREE - No cost)
# Get your key at: https://www.pexels.com/api/
# ----------------------------------------------------------
PEXELS_API_KEY=key_here

# ----------------------------------------------------------
# YouTube / Channel Settings
# ----------------------------------------------------------
YOUTUBE_CHANNEL_NAME=Nikhil Tech

# ----------------------------------------------------------
# Edge TTS Voice & Prosody Settings
# Requires: pip install edge-tts
#
# BEST NATURAL-SOUNDING ENGLISH VOICES:
#   en-US-AriaNeural    <- warm, conversational female (recommended)
#   en-US-GuyNeural     <- natural, clear male
#   en-US-JennyNeural   <- friendly female
#   en-US-DavisNeural   <- expressive male
#   en-GB-RyanNeural    <- British male (great for documentary style)
#   en-GB-SoniaNeural   <- British female
#
# Hindi  : hi-IN-SwaraNeural | hi-IN-MadhurNeural
# Telugu : te-IN-ShrutiNeural | te-IN-MohanNeural
# Tamil  : ta-IN-PallaviNeural | ta-IN-ValluvarNeural
# ----------------------------------------------------------
EDGE_TTS_VOICE=en-US-EmmaMultilingualNeural

# Rate: "-10%" = slower | "+5%" = faster
EDGE_TTS_RATE=-1%

# Pitch: "-5Hz" = deeper | "+2Hz" = higher
EDGE_TTS_PITCH=-2Hz

# Volume: "+0%" = normal | "+10%" = louder
EDGE_TTS_VOLUME=+0%

# ----------------------------------------------------------
# Video Settings
# ----------------------------------------------------------
# Output resolution
VIDEO_RESOLUTION=1920x1080

# Output frame rate
VIDEO_FPS=30

# Crossfade transition duration between segments (seconds)
TRANSITION_DURATION=0.5

# Pexels video orientation filter: landscape, portrait, square (leave empty for any)
VIDEO_ORIENTATION=landscape

# Pexels video size: large (4K), medium (Full HD), small (HD)
VIDEO_SIZE=medium

# ----------------------------------------------------------
# Text Overlay Settings
# ----------------------------------------------------------
# Font size for heading text
OVERLAY_HEADING_FONT_SIZE=64

# Font size for subtitle text
OVERLAY_SUBTITLE_FONT_SIZE=42

# Font color (FFmpeg color name or hex like 0xFFFFFF)
OVERLAY_FONT_COLOR=white

# Background box opacity behind text (0.0 to 1.0)
OVERLAY_BG_OPACITY=0.6

# ----------------------------------------------------------
# Background Music Settings
# ----------------------------------------------------------
# Enable/disable background music (true/false)
BG_MUSIC_ENABLED=true

# Music source: "local_library", "auto" (generate ambient), "url" (download), "file" (single local path)
BG_MUSIC_SOURCE=local_library

# Background music volume (0.0 to 1.0)
BG_MUSIC_VOLUME=0.065
